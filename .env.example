# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-replace-me

# live: watch your own server (needs everything below). demo: every chat gets a simulated server.
MODE=live

# Chats allowed to use the bot (comma-separated). Send /start to the bot to see a chat's id.
TELEGRAM_CHAT_ID=-1001234567890

# From pairing (see README: Pairing)
RUST_SERVER_IP=1.2.3.4
RUST_SERVER_PORT=28082
RUST_PLAYER_ID=76561198000000000
RUST_PLAYER_TOKEN=-1234567890

# Paired devices: a JSON file (default) or inline JSON in DEVICES
DEVICES_FILE=data/devices.json

# Optional
POLL_SECONDS=10
UPKEEP_WARN_MINUTES=180
